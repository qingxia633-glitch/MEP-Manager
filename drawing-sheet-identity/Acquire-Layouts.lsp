; Load Test-AutoCADEntities.lsp first. Getter-only sidecar, no save/setvar/activation.
; CAD ReportVersion 2.9 is independent of the unchanged 2.8 ModelSpace report.
(defun dsi:owner-reference (d / depth owners done pair)
  (setq depth 0 owners nil done nil)
  (foreach pair d
    (if (not done)
      (cond
        ((= (car pair) 102)
          (if (= (cdr pair) "}") (setq depth (1- depth)) (setq depth (1+ depth))))
        ((and (= depth 0) (= (car pair) 100)) (setq done T))
        ((and (= depth 0) (= (car pair) 330)) (setq owners (cons (cdr pair) owners))))))
  (if (and (= depth 0) (= (length owners) 1)) (car owners) nil))

(defun dsi:entity (obj lname bh / e d result owner od)
  (setq e (vlax-vla-object->ename obj) d (entget e))
  (setq owner (dsi:owner-reference d) od (if owner (entget owner) nil))
  (mep2:out "PaperEntity_BEGIN")
  (mep2:val "EntityHandle" (cdr (assoc 5 d)))
  (mep2:val "DXF_Type" (cdr (assoc 0 d)))
  (mep2:val "EntityLayoutName" (cdr (assoc 410 d)))
  (mep2:val "EntityOwnerBlock" (cdr (assoc 5 od)))
  (mep2:val "EntityOwnerType" (cdr (assoc 0 od)))
  (setq result (vl-catch-all-apply 'mep2:details (list e d)))
  (if (vl-catch-all-error-p result)
    (progn (setq dsi:errors (1+ dsi:errors)) (mep2:val "EntityError" (vl-catch-all-error-message result))))
  (mep2:out "PaperEntity_END"))

(defun dsi:layout (lo / name lh b bh model order obj count result dsi:errors)
  (setq name (vla-get-Name lo) lh (vla-get-Handle lo)
        b (vla-get-Block lo) bh (vla-get-Handle b) model (= (vla-get-ModelType lo) :vlax-true)
        order (vl-catch-all-apply 'vla-get-TabOrder (list lo)) count 0 dsi:errors 0)
  (mep2:out "Layout_BEGIN")
  (mep2:val "LayoutName" name)
  (mep2:val "LayoutHandle" lh)
  (mep2:val "SpaceBlockHandle" bh)
  (mep2:val "SpaceType" (if model "ModelSpace" "PaperSpace"))
  (mep2:val "LayoutOrder" (if (vl-catch-all-error-p order) nil order))
  (mep2:val "LayoutAcquisitionStatus" "read")
  (if (not model)
    (vlax-for obj b
      (setq result (vl-catch-all-apply 'dsi:entity (list obj name bh)))
      (if (vl-catch-all-error-p result)
        (progn (setq dsi:errors (1+ dsi:errors)) (mep2:val "LayoutEntityError" (vl-catch-all-error-message result)))
        (setq count (1+ count)))))
  (mep2:val "LayoutEntityCount" count)
  (mep2:val "LayoutReadErrorCount" dsi:errors)
  (mep2:out "Layout_END")
  (vlax-release-object b))

(defun dsi:write (path / *error* full stage doc layouts lo result count)
  (defun *error* (msg)
    (if mep2:fh (progn (write-line "INCOMPLETE_LAYOUT_REPORT" mep2:fh) (close mep2:fh) (setq mep2:fh nil)))
    (princ (strcat "\nLayout acquisition failed: " msg)) (princ))
  (vl-load-com)
  (if (or (findfile path) (not (= (substr path 2 1) ":")))
    (princ "\nRejected existing or non-absolute output path.")
    (progn
      (setq full T stage "layout-sidecar" count 0)
      (setq mep2:fh (if (= (getvar "LISPSYS") 0) (open path "w") (open path "w" "utf8-bom")))
      (if (not mep2:fh) (exit))
      (mep2:val "ReportVersion" "2.9-layout-identity-v1")
      (mep2:val "DrawingSheetIdentityEvidenceVersion" "1")
      (mep2:val "LayoutOwnerContractVersion" "1")
      (mep2:val "OwnerExtractionSelfTest"
        (if (and
          (= (dsi:owner-reference '((102 . "{ACAD_REACTORS") (330 . "reactor") (102 . "}") (330 . "owner") (100 . "AcDbEntity"))) "owner")
          (not (dsi:owner-reference '((330 . "a") (330 . "b") (100 . "AcDbEntity"))))) "PASS" "FAIL"))
      (mep2:val "DWG" (strcat (getvar "DWGPREFIX") (getvar "DWGNAME")))
      (mep2:val "LayoutInventoryStatus" "read")
      (mep2:val "ModelSpaceEvidence" "separate unchanged MEPFULLREAD report; inventory only here")
      (mep2:val "LayoutEvidence" "each Layout.Block; PaperSpace top-level only; attached ATTRIB; no recursive block/Xref expansion")
      (mep2:val "AcquiredAtLocal" (getvar "CDATE"))
      (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)) layouts (vla-get-Layouts doc))
      (vlax-for lo layouts
        (setq result (vl-catch-all-apply 'dsi:layout (list lo)))
        (if (vl-catch-all-error-p result)
          (progn (mep2:val "LayoutInventoryError" (vl-catch-all-error-message result)) (exit)))
        (setq count (1+ count)))
      (mep2:val "LayoutCount" count)
      (mep2:out "END_LAYOUT_REPORT")
      (close mep2:fh) (setq mep2:fh nil)
      (vlax-release-object layouts) (vlax-release-object doc)
      (princ (strcat "\nLayout report saved: " path))))
  (princ))

(defun c:MEPLAYOUTREAD (/ path)
  (setq path (getfiled "New layout report" (strcat (getvar "DWGPREFIX") "MEP-layout-report.txt") "txt" 1))
  (if path (dsi:write path)) (princ))
(princ "\nLoaded MEPLAYOUTREAD: independent Layout identity report 2.9.")
(princ)
