; Pure helper tests; no drawing mutation or test entities.
(defun tnp:assert (ok message)
  (if (not ok) (error (strcat "Probe helper test failed: " message))))
(defun c:MEPTARGETPROBETEST (/ tnp:fh tnp:queue tnp:scheduled tnp:blocks)
  (tnp:assert (equal (tnp:owner '((0 . "LINE") (102 . "{ACAD_REACTORS") (330 . "R") (102 . "}") (330 . "O") (100 . "AcDbEntity"))) "O") "reactor separation")
  (tnp:assert (null (tnp:owner '((102 . "{ACAD_REACTORS") (330 . "R")))) "unclosed section")
  (tnp:assert (null (tnp:owner '((330 . "A") (330 . "B")))) "ambiguous owner")
  (tnp:assert (= (tnp:role "GROUP" 340 nil) "group_member") "GROUP")
  (tnp:assert (= (tnp:role "LEADER" 340 nil) "annotation_reference") "LEADER")
  (tnp:assert (= (tnp:role "MLEADER" 340 nil) "uninterpreted_reference") "MLEADER")
  (tnp:assert (not (tnp:valid-handles '("A" "A"))) "duplicate seeds")
  (tnp:assert (not (tnp:valid-handles '("G"))) "invalid handle")
  (tnp:assert (tnp:valid-handles '("A" "B")) "valid handles")
  (tnp:assert (= (tnp:json 'tnp:empty-array) "[]") "empty identity path")
  (tnp:enqueue "A" 0 nil "seed")
  (tnp:enqueue "A" 1 '("A") "cycle")
  (tnp:assert (= (length tnp:queue) 1) "cycle dedup")
  (tnp:enqueue "B" 9 nil "depth")
  (tnp:assert (= (length tnp:queue) 1) "depth limit")
  (princ "\nMEPTARGETPROBETEST: 12 helper checks passed; real acquisition still required.") (princ))
(princ)
