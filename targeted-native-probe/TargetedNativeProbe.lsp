; TargetedNativeProbe/1. Getter-only. No save, mutation, selection or view changes.
(vl-load-com)
(defun tnp:call (stage fn args / before after result)
  (setq before (getvar "DBMOD") result (vl-catch-all-apply fn args) after (getvar "DBMOD"))
  (if (and (eq fn 'entget) (not (vl-catch-all-error-p result)) (listp result)
           (assoc -1 result) (assoc 5 result))
    (setq tnp:handles (cons (cons (cdr (assoc -1 result)) (cdr (assoc 5 result))) tnp:handles)))
  (if tnp:trace-path (tnp:trace stage before after (vl-symbol-name fn)))
  (tnp:emit (list '("kind" . "dbmod_stage") (cons "stage" stage) (cons "call" (vl-symbol-name fn))
    (cons "target_context" h) (cons "argument_tokens" (mapcar 'vl-prin1-to-string args)) (cons "before" before) (cons "after" after)))
  (if (/= before after) (progn (princ (strcat "\nDBMOD changed during " stage ": " (vl-symbol-name fn))) (exit)))
  result)
(defun tnp:trace (stage before after call / f)
  (setq f (open tnp:trace-path "a" "utf8-bom"))
  (if f (progn (write-line (strcat stage "|" (itoa before) "|" (itoa after) "|" call) f) (close f))))
(defun tnp:extension (d / stack refs seen bad p)
  (foreach p d
    (cond ((= (car p) 102)
      (cond ((= (cdr p) "}") (if stack (setq stack (cdr stack)) (setq bad T)))
        ((and (= (type (cdr p)) 'STR) (= (substr (cdr p) 1 1) "{"))
          (setq stack (cons (cdr p) stack)) (if (= (cdr p) "{ACAD_XDICTIONARY") (setq seen T)))
        (T (setq bad T))))
      ((and (= (car p) 360) (= (car stack) "{ACAD_XDICTIONARY")) (setq refs (cons (cdr p) refs)))))
  (cond ((or bad stack) (list "unavailable" nil)) ((not seen) (list "absent" nil))
    ((and (= (length refs) 1) (= (type (car refs)) 'ENAME)) (list "read" (car refs)))
    (T (list "unavailable" nil))))
(defun tnp:q (s / out c)
  (setq out "\"")
  (foreach c (vl-string->list s)
    (setq out (strcat out (cond ((= c 34) "\\\"") ((= c 92) "\\\\")
      ((= c 10) "\\n") ((= c 13) "\\r") ((= c 9) "\\t")
      ((< c 32) (strcat "\\u00" (substr "0123456789abcdef" (1+ (fix (/ c 16))) 1) (substr "0123456789abcdef" (1+ (rem c 16)) 1)))
      (T (chr c)))))) (strcat out "\""))
(defun tnp:handle (e / d)
  (if (= (type e) 'ENAME)
    (if (assoc e tnp:handles) (cdr (assoc e tnp:handles))
      (progn (setq d (tnp:call "reference_handle_lookup" 'entget (list e))) (if (not (vl-catch-all-error-p d)) (cdr (assoc 5 d))))) nil))
(defun tnp:json (v / s sep)
  (cond ((eq v 'tnp:empty-array) "[]") ((null v) "null") ((eq v T) "true")
    ((= (type v) 'STR) (tnp:q v)) ((= (type v) 'INT) (itoa v))
    ((= (type v) 'REAL) (tnp:q (rtos v 2 12)))
    ((= (type v) 'ENAME)
      (if (assoc v tnp:handles) (tnp:q (cdr (assoc v tnp:handles)))
        (strcat "{\"reference_status\":\"unresolved_not_dereferenced\",\"session_token\":" (tnp:q (vl-prin1-to-string v)) "}")))
    ((listp v) (setq s "[" sep "")
      (while (and v (listp v)) (setq s (strcat s sep (tnp:json (car v))) sep "," v (cdr v)))
      (if v (setq s (strcat s sep (tnp:json v)))) (strcat s "]"))
    (T (tnp:q (vl-prin1-to-string v)))))
(defun tnp:emit (pairs / s sep p before after)
  (setq before (getvar "DBMOD") s "{" sep "")
  (foreach p pairs (setq s (strcat s sep (tnp:q (car p)) ":" (tnp:json (cdr p))) sep ","))
  (write-line (strcat s "}") tnp:fh)
  (setq after (getvar "DBMOD"))
  (if tnp:trace-path (tnp:trace "report_output" before after "serialize/write-line"))
  (if (/= before after) (progn (princ "\nDBMOD changed during report output") (exit))))
(defun tnp:raw (d / out p)
  (foreach p d (setq out (cons (list (car p) (vl-symbol-name (type (cdr p))) (cdr p)) out))) (reverse out))
(defun tnp:owner (d / stack owners header bad p)
  (setq header T)
  (foreach p d
    (cond ((= (car p) 102)
      (cond ((= (cdr p) "}") (if stack (setq stack (cdr stack)) (setq bad T)))
        ((and (= (type (cdr p)) 'STR) (= (substr (cdr p) 1 1) "{")) (setq stack (cons (cdr p) stack)))
        (T (setq bad T))))
      ((null stack) (cond ((= (car p) 100) (setq header nil))
        ((and header (= (car p) 330)) (setq owners (cons (cdr p) owners)))))))
  (if (and (not bad) (not stack) (= (length owners) 1)) (car owners) nil))
(defun tnp:role (typ code section)
  (cond ((= section "{ACAD_REACTORS") "reactor_reference")
    ((and (= section "{ACAD_XDICTIONARY") (= code 360)) "extension_dictionary")
    (section "uninterpreted_reference")
    ((and (= typ "GROUP") (= code 340)) "group_member")
    ((and (= typ "LEADER") (= code 340)) "annotation_reference")
    ((and (= typ "DICTIONARY") (member code '(350 360))) "dictionary_entry")
    (T "uninterpreted_reference")))
(defun tnp:gap (reason h)
  (tnp:emit (list '("kind" . "gap") (cons "reason" reason) (cons "handle" h))))
(defun tnp:enqueue (h depth path reason / key)
  (cond ((not h) (tnp:gap "missing_reference_handle" nil))
    ((> depth 8) (tnp:gap "depth_limit" h))
    ((member h tnp:scheduled) (tnp:emit (list '("kind" . "revisit") (cons "handle" h) (cons "traversal_path" path) (cons "reason" reason))))
    ((>= (length tnp:scheduled) 256) (tnp:gap "node_limit" h))
    (T (setq tnp:scheduled (cons h tnp:scheduled) tnp:queue (append tnp:queue (list (list h depth path reason)))))))
(defun tnp:refs (h d depth path / stack p code value role typ owner)
  (setq typ (cdr (assoc 0 d)) owner (tnp:owner d))
  (foreach p d
    (setq code (car p) value (cdr p))
    (if (= code 102) (if (= value "}") (setq stack (cdr stack)) (setq stack (cons value stack))))
    (if (and (>= code 320) (<= code 369))
      (progn
        (setq role (if (and (not stack) (= code 330) (equal value owner)) "owner" (tnp:role typ code (car stack))))
        (tnp:emit (list '("kind" . "reference") (cons "source" h) (cons "code" code) (cons "section" (car stack))
          (cons "role" role) (cons "target" value) '("engineering_meaning" . "unresolved")))
        (if (and (= (type value) 'ENAME) (or (= typ "XRECORD") (member role '("reactor_reference" "extension_dictionary" "dictionary_entry" "group_member" "annotation_reference"))))
          (tnp:enqueue (tnp:handle value) (1+ depth) (append path (list h)) role))))))
(defun tnp:xrefs (v h depth path)
  (if (listp v)
    (if (and (numberp (car v)) (= (car v) 1005) (= (type (cdr v)) 'STR))
      (progn (tnp:emit (list '("kind" . "reference") (cons "source" h) '("code" . 1005) '("role" . "xdata_handle_uninterpreted") (cons "target" (cdr v))))
        (if (tnp:call "xdata_reference" 'handent (list (cdr v))) (tnp:enqueue (cdr v) (1+ depth) (append path (list h)) "xdata_handle") (tnp:gap "unresolved_xdata_handle" (cdr v))))
      (progn (if (car v) (tnp:xrefs (car v) h depth path)) (if (cdr v) (tnp:xrefs (cdr v) h depth path))))))
(defun tnp:block (h name depth path / b e d count bh begin bd br rd valid)
  (setq b (tnp:call "block_definition" 'tblsearch (list "BLOCK" name)) begin (tnp:call "block_definition" 'tblobjname (list "BLOCK" name))
    bd (if begin (tnp:call "block_begin" 'entget (list begin)))
    br (if (= (cdr (assoc 0 bd)) "BLOCK") (tnp:owner bd))
    rd (if br (tnp:call "block_record" 'entget (list br)))
    valid (and (= (cdr (assoc 0 rd)) "BLOCK_RECORD") (= (cdr (assoc 2 rd)) name))
    bh (if valid (cdr (assoc 5 rd))))
  (tnp:emit (list '("kind" . "insert_definition") (cons "insert" h) (cons "block_name" name) (cons "insert_handle" h) (cons "block_begin_handle" (cdr (assoc 5 bd)))
    (cons "block_record_handle" bh) (cons "identity_status" (if valid "read" "unresolved"))
    (cons "block_begin_raw" (if bd (tnp:raw bd))) (cons "block_record_raw" (if rd (tnp:raw rd)))
    (cons "effective_block_name" (if (and effective (not (vl-catch-all-error-p effective))) effective))
    (cons "traversal_path" path) (cons "definition_raw" (if b (tnp:raw b))) '("transform_status" . "raw DXF 10/41/42/43/50/210; not composed")))
  (cond ((not b) (tnp:gap "missing_block_definition" h))
    ((/= 0 (logand 12 (cdr (assoc 70 b)))) (tnp:gap "xref_definition_out_of_scope" h))
    (T (tnp:enqueue (cdr (assoc 5 bd)) (1+ depth) (append path (list h)) "block_begin")
      (if (not valid) (tnp:gap "unresolved_block_record_identity" h))
      (tnp:enqueue bh (1+ depth) (append path (list h)) "block_record")
      (if (not (member name tnp:blocks))
        (progn (setq tnp:blocks (cons name tnp:blocks) e (cdr (assoc -2 b)) count 0)
          (while (and e (< count 512) (< (length tnp:scheduled) 256))
            (setq d (tnp:call "entity_data" 'entget (list e)))
            (if (or (not d) (= (cdr (assoc 0 d)) "ENDBLK")) (setq e nil)
              (progn (tnp:enqueue (cdr (assoc 5 d)) (1+ depth) (append path (list h bh)) "definition_entity")
                (setq count (1+ count) e (tnp:call "block_definition" 'entnext (list e))))))
          (if e (tnp:gap "definition_traversal_limit" h)))))))
(defun tnp:node (item / h depth path e d ow od typ obj effective res sub sd count ext plain)
  (setq h (car item) depth (cadr item) path (caddr item) e (tnp:call "entity_lookup" 'handent (list h))
    plain (if e (tnp:call (if (= (cadddr item) "extension_dictionary") "extension_dictionary_read" "entity_data") 'entget (list e)))
    d (if e (tnp:call "xdata_read" 'entget (list e '("*")))))
  (setq tnp:count (1+ tnp:count))
  (if (or (not d) (vl-catch-all-error-p d))
    (tnp:emit (list '("kind" . "node") (cons "handle" h) '("read_status" . "unavailable") '("xdata_status" . "unavailable")))
    (progn (setq ext (tnp:extension d) ow (tnp:owner d) od (if ow (tnp:call "owner_data" 'entget (list ow))) typ (cdr (assoc 0 d)))
      (tnp:emit (list '("kind" . "node") (cons "handle" h) (cons "entity_type" typ) (cons "depth" depth)
        (cons "traversal_path" path) (cons "owner" (tnp:handle ow)) (cons "owner_status" (if ow "read" "unresolved"))
        (cons "owner_raw" (if od (tnp:raw od)))
        (cons "parent_path" (if (= (strcase (if (assoc 2 od) (cdr (assoc 2 od)) "")) "*MODEL_SPACE") 'tnp:empty-array nil))
        (cons "parent_path_status" (if (= (strcase (if (assoc 2 od) (cdr (assoc 2 od)) "")) "*MODEL_SPACE") "top_level_verified" "unresolved_instance_path"))
        (cons "extension_dictionary_status" (car ext)) (cons "extension_dictionary_handle" (tnp:handle (cadr ext)))
        (cons "layout" (cdr (assoc 410 d))) '("read_status" . "read")
        (cons "xdata_status" (if (assoc -3 d) "read" "absent")) (cons "raw" (tnp:raw d))))
      (tnp:refs h d depth path) (if (assoc -3 d) (tnp:xrefs (cdr (assoc -3 d)) h depth path))
      (if (not (member typ '("LINE" "LWPOLYLINE" "POLYLINE" "VERTEX" "SEQEND" "POINT" "ARC" "CIRCLE" "SPLINE" "TEXT" "MTEXT" "ATTRIB" "ATTDEF" "INSERT" "BLOCK" "BLOCK_RECORD" "DICTIONARY" "XRECORD" "GROUP" "LEADER" "MULTILEADER" "MLEADER"))) (tnp:gap "unsupported_object_interpretation_raw_retained" h))
      (if (member typ '("MLEADER" "MULTILEADER")) (tnp:gap "mleader_context_raw_only" h))
      (if (= typ "INSERT")
        (progn
          (setq res (tnp:call "effective_name_object" 'vlax-ename->vla-object (list e)))
          (if (not (vl-catch-all-error-p res))
            (progn (setq obj res effective (tnp:call "effective_name_getter" 'vla-get-EffectiveName (list obj))) (tnp:call "effective_name_release" 'vlax-release-object (list obj)))
            (setq effective res))
          (tnp:emit (list '("kind" . "effective_block") (cons "insert" h)
            (cons "status" (if (vl-catch-all-error-p effective) "unavailable" "read"))
            (cons "value" (if (not (vl-catch-all-error-p effective)) effective))))
          (tnp:block h (cdr (assoc 2 d)) depth path)))
      (if (or (= typ "POLYLINE") (and (= typ "INSERT") (= 1 (cdr (assoc 66 d)))))
        (progn (setq sub (tnp:call "block_definition" 'entnext (list e)) count 0)
          (while (and sub (< count 512))
            (setq sd (tnp:call "subentity_data" 'entget (list sub)))
            (cond ((not sd) (tnp:gap "subentity_read_failed" h) (setq sub nil))
              ((= (cdr (assoc 0 sd)) "SEQEND") (setq sub nil))
              ((not (member (cdr (assoc 0 sd)) (if (= typ "INSERT") '("ATTRIB") '("VERTEX"))))
                (tnp:gap "unexpected_subentity_type" h) (setq sub nil))
              (T (tnp:enqueue (cdr (assoc 5 sd)) (1+ depth) (append path (list h)) "owned_subentity")
                (setq count (1+ count) sub (tnp:call "subentity_data" 'entnext (list sub))))))
          (if sub (tnp:gap "subentity_limit" h)))))))
(defun tnp:drain (/ item)
  (while tnp:queue (setq item (car tnp:queue) tnp:queue (cdr tnp:queue)) (tnp:node item)))
(defun tnp:groups (seeds / gd ge entry d members hit p n h)
  (setq gd (tnp:call "group_query" 'dictsearch (list (tnp:call "group_query" 'namedobjdict nil) "ACAD_GROUP")) n 0)
  (if gd
    (progn (setq ge (cdr (assoc -1 gd)) entry (tnp:call "group_query" 'dictnext (list ge T)))
      (while (and entry (< n 10000))
        (setq n (1+ n) members nil hit nil d entry h (cdr (assoc 5 d)))
        (foreach p d (if (= (car p) 340) (progn (setq members (cons (tnp:handle (cdr p)) members)) (if (member (tnp:handle (cdr p)) seeds) (setq hit T)))))
        (if hit (progn (tnp:emit (list '("kind" . "group_membership") (cons "group" h) (cons "members" (reverse members)) '("query_scope" . "seed handles only") '("semantic_scope" . "unresolved")))
          (tnp:enqueue h 1 nil "reverse_group_match")))
        (setq entry (tnp:call "group_query" 'dictnext (list ge))))
      (if entry (tnp:gap "group_index_limit" nil))))
  (tnp:emit (list '("kind" . "group_query") (cons "checked_entries" n)
    (cons "status" (cond (entry "incomplete") (gd "complete_for_seeds") (T "group_dictionary_absent"))) (cons "seeds" seeds))))
(defun tnp:valid-handles (handles / ok h seen)
  (setq ok (and handles (listp handles)))
  (foreach h handles
    (if (/= (type h) 'STR) (setq ok nil)
      (if (or (= h "") (wcmatch h "*[~0-9A-F]*") (member h seen)) (setq ok nil) (setq seen (cons h seen))))) ok)
(defun tnp:run (handles project expected output / *error* tnp:fh tnp:queue tnp:scheduled tnp:blocks tnp:count tnp:handles start h)
  (defun *error* (msg) (if tnp:fh (close tnp:fh)) (princ (strcat "\nIncomplete probe: " msg)) (princ))
  (cond ((not (tnp:valid-handles handles)) (princ "\nInvalid seed handles."))
    ((or (/= (type project) 'STR) (= project "")) (princ "\nProject required."))
    ((/= (strcase (vl-string-translate "\\" "/" expected)) (strcase (vl-string-translate "\\" "/" (strcat (getvar "DWGPREFIX") (getvar "DWGNAME"))))) (princ "\nWrong active drawing; stopped."))
    ((/= 0 (getvar "DBMOD")) (princ "\nDrawing has unsaved changes; stopped. Do not save to bypass."))
    ((not (member (getvar "LISPSYS") '(1 2))) (princ "\nUnicode host required; no setting changed."))
    ((findfile output) (princ "\nExisting output protected."))
    (T (setq tnp:fh (open output "w" "utf8-bom") tnp:count 0 start (getvar "DBMOD"))
      (if (not tnp:fh) (exit))
      (tnp:emit (list '("kind" . "header") '("contract" . "TargetedNativeProbe/1") (cons "project_id" project)
        (cons "drawing_path" (strcat (getvar "DWGPREFIX") (getvar "DWGNAME"))) (cons "seeds" handles)
        (cons "collector_revision" 3) (cons "dbmod" start) (cons "acadver" (getvar "ACADVER")) (cons "acquired_local" (getvar "CDATE"))
        '("scope" . "seed relation closure plus seed reverse GROUP index; no all-entity scan")))
      (foreach h handles (tnp:enqueue h 0 nil "seed"))
      (tnp:drain) (tnp:call "group_query_total" 'tnp:groups (list handles)) (tnp:drain)
      (tnp:emit (list '("kind" . "footer") '("completed" . T) (cons "node_count" tnp:count)
        (cons "dbmod" (getvar "DBMOD")) '("coverage" . "incomplete") '("reverse_arbitrary" . "not_acquired")))
      (close tnp:fh) (setq tnp:fh nil) (princ "\nProbe written. Do not save DWG; validate output externally."))) (princ))
(defun c:MEPTARGETPROBE (/ handles text project expected output)
  (setq text (getstring T "\nSeed handles separated by spaces: ") handles nil)
  (while (> (strlen text) 0)
    (if (vl-string-search " " text)
      (progn (if (> (vl-string-search " " text) 0) (setq handles (append handles (list (substr text 1 (vl-string-search " " text))))))
        (setq text (substr text (+ 2 (vl-string-search " " text)))))
      (setq handles (append handles (list text)) text "")))
  (setq project (getstring T "\nProject identity: ") expected (getstring T "\nExpected Shadow DWG full path: ")
    output (getfiled "New targeted-native.jsonl" (strcat (getvar "DWGPREFIX") "targeted-native.jsonl") "jsonl" 1))
  (if output (tnp:run handles project expected output)) (princ))
(princ)
